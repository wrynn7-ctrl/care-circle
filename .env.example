# Copy to .env.local (gitignored). Only EXPO_PUBLIC_* values ship in the app bundle; they are safe to expose.
# Local stack: run `npx supabase start` and paste the printed values.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional. Crash reporting is disabled when empty. See src/lib/sentry.ts for what is scrubbed.
EXPO_PUBLIC_SENTRY_DSN=
# Google sign-in: the Web client ID from Google Cloud Console (used on Android and iOS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Screenshot runner only (never in the app): local service role key, for creating a signed-in session.
SUPABASE_SERVICE_ROLE_KEY=
